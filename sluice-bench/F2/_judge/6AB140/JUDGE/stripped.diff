+    expect(args.holdS).toBeUndefined();
+    expect(args.backS).toBe(1.8);
+    const act = jump.act!(cast, m);
+    const rings = act.filter((c) => c.cmd === 'ring').map((c) => c.args as { at: unknown; r: number; r1: number; color: number; durS: number; alpha: number });
+    expect(rings).toHaveLength(2);
+    const [blip, arrival] = rings as [typeof rings[0], typeof rings[0]];
+    expect(blip.at).toEqual(cast.agent[0]!.at);
+    expect(arrival.at).toEqual(cast.facility[0]!.at);
+    expect(blip.color).toBe(arrival.color);
+    expect(blip.r1 / blip.r).toBeCloseTo(arrival.r1 / arrival.r, 9);
+    expect(blip.durS).toBe(arrival.durS);
+    expect(blip.alpha).toBe(arrival.alpha);
+    expect(act.filter((c) => 'act' in c).map((c) => (c as unknown as { act: { act: string } }).act.act)).toEqual(['jump']);
+    expect(act.filter((c) => c.cmd === 'ring' && (c as Call & { value?: number }).value === 0)).toEqual([]); // the blip is not a repeat
+  });
+
+  /** A scene stub for a real Sortie: every placeAt recorded. */
+  function sortieScene(goal: [number, number]) {
+    const placed: [number, number][] = [];
+    const scene = {
+      own: () => {}, release: () => {}, restoreFacing: () => {}, faceView: () => {}, fadeView: () => {}, facingOf: () => 1,
+      placeAt: (_pk: string, x: number, y: number) => placed.push([x, y]),
+      goalOf: () => goal, currentScale: () => 1, fxLayer: () => ({ addChild: () => {} }),
+    };
+    return { scene, placed };
+  }
+
+  for (const waitS of [0, 1.8]) {
+    it(`(b) a Sortie in pass mode never stops: waitS ${waitS}`, () => {
+      const spot: [number, number] = [300, 100];
+      const goal: [number, number] = [60, 40];
+      const { scene, placed } = sortieScene(goal);
+      const sortie = new Sortie(scene, 'ag', [0, 0], () => spot, () => [400, 100], 0.715, 0, 1.8, 0, false, waitS, { turnR: 19 });
+      const dt = 1 / 60;
+      let t = 0;
+      let atOut: [number, number] | null = null;
+      let openBefore = 1, openAfter = 0;
+      for (let i = 0; i < 2000; i++) {
+        // One short step lands exactly on the out leg's end, to read the spot there.
+        const step = !atOut && t + dt > 0.715 ? 0.715 - t + 1e-9 : dt;
+        const more = sortie.update(step);
+        t += step;
+        const p = placed[placed.length - 1]!;
+        const q = placed[placed.length - 2]!;
+        if (more && step === dt) expect(Math.hypot(p[0] - q[0], p[1] - q[1]), `frame ${i} at ${t.toFixed(3)} s`).toBeGreaterThan(1e-6);
+        if (!atOut && t >= 0.715) atOut = p;
+        if (t < 0.7) openBefore = Math.min(openBefore, 0) + sortie.crewOpen(0.52);
+        if (Math.abs(t - (0.715 + 0.9)) < dt / 2) openAfter = sortie.crewOpen(0.52);
+        if (!more) break;
+      }
+      expect(Math.hypot(atOut![0] - spot[0], atOut![1] - spot[1])).toBeLessThan(1); // at the spot at outS
+      const last = placed[placed.length - 1]!;
+      expect(last[0]).toBeCloseTo(goal[0], 6); // ends at goalOf
+      expect(last[1]).toBeCloseTo(goal[1], 6);
+      expect(openBefore).toBe(0);
+      expect(openAfter).toBeGreaterThan(0);
+      expect(t).toBeCloseTo(0.715 + waitS + 1.8, 1);
+    });
+  }
+
+  it('(b) the coast stays within turnR of the spot, and the ship does not reverse at it', () => {
+    const spot: [number, number] = [300, 100];
+    const { scene, placed } = sortieScene([60, 40]);
+    const sortie = new Sortie(scene, 'ag', [0, 0], () => spot, () => [400, 100], 0.715, 0, 1.8, 0, false, 1.8, { turnR: 19 });
+    const out = Math.ceil(0.715 * 60); // the first frame past the out leg
+    const coastEnd = Math.floor((0.715 + 1.8) * 60) - 1; // the last frame still in the coast
+    for (let i = 1; i <= coastEnd; i++) sortie.update(1 / 60);
+    const far = Math.max(...placed.slice(out + 1).map((p) => Math.hypot(p[0] - spot[0], p[1] - spot[1])));
+    expect(far).toBeLessThanOrEqual(19 + 1e-6);
+    expect(far).toBeGreaterThan(10); // it did carry on past the spot
+  });
+
+  it('(c) the blip and the station\'s act start within 50 ms of each other', () => {
+    registry.installTheme({ maneuvers, commands: [] });
+    const FAC = 'fac|1';
+    const board = [node(FAC, 'repo:org:r' as CanonicalKey, 'facility', 100), node('ship|a', A, 'captain', 0)];
+    const { fx, scene, clock, run, ctx } = rig(board, board.slice(1));
+    // The scene's art-act seam (`actView`) logs the station's act.
+    (scene as unknown as { actView: (pk: string, act: string) => boolean }).actView = (pk, act) => { scene.log.push(`${Math.round(clock.ms)} act ${pk} ${act}`); return true; };
+    // The ring recorder logs its point and size; the host logs the station's act.
+    commands.registerCommand({
+      ...commands.commandByName('ring')!,
+      make: (_h: unknown, a: { at: unknown; r: number }) => {
+        const p = calls.pointOf(a.at);
+        scene.log.push(`${Math.round(clock.ms)} ring ${a.r.toFixed(2)} ${p ? p.map((x) => x.toFixed(0)).join(',') : '-'}`);
+        let t = 0;
+        return { kind: 'accent', update: (dt: number) => (t += dt) < 0.5, destroy: () => {} };
+      },
+    } as Def);
+    fx.queue(ctx([{ ...planned(RULE.facilityEnter, 'e1', { subject: ['repo:org:r' as CanonicalKey], facility: ['repo:org:r' as CanonicalKey], agent: [A] }), passes: true }]));
+    const errs: unknown[] = []; const oe = console.error; console.error = (...a: unknown[]) => { errs.push(a); };
+    run(3000);
+    console.error = oe; if (errs.length) throw new Error(String((errs[0] as unknown[])[1] ?? errs[0]));
+    const actAt = time(scene.log, 'act fac|1 jump');
+    const rings = scene.log.filter((l) => / ring /.test(l));
+    expect(actAt, scene.log.join('\n')).toBeGreaterThan(0);
+    const blip = rings.find((l) => l.endsWith(' 0,0') || l.includes(' ring 7.00 '));
+    expect(blip, scene.log.join('\n')).toBeDefined();
+    expect(Math.abs(Number(blip!.split(' ')[0]) - actAt)).toBeLessThanOrEqual(50);
+  });
+});
