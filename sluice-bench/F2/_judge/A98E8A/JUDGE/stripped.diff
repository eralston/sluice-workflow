+  for (const [name, goal] of [['a goal away from the start', [-120, 260]], ['a goal = the start (teardrop)', [0, 0]]] as const) {
+    it(`flies through the spot without stopping, to ${name}`, async () => {
+      const r = await fly([goal[0], goal[1]]);
+      const L = Math.hypot(r.spot[0], r.spot[1]);
+      // At the spot as the out leg ends (to within the step it lands in: the speed there is V, a few units a frame).
+      const near = r.pts.reduce((best, p) => Math.min(best, Math.hypot(p[0] - r.spot[0], p[1] - r.spot[1])), Infinity);
+      expect(near / L).toBeLessThan(0.02);
+      expect(r.steps).toBe(Math.ceil((OUT + BACK) * 60 - 1e-9));
+      // Every step moves, until it comes to rest at the goal.
+      for (let i = 1; i < r.pts.length - 1; i++) {
+        expect(r.pts[i]![0] === r.pts[i - 1]![0] && r.pts[i]![1] === r.pts[i - 1]![1]).toBe(false);
+      }
+      const end = r.pts[r.pts.length - 1]!;
+      expect(Math.hypot(end[0] - goal[0], end[1] - goal[1])).toBeLessThan(1e-6 * Math.max(1, L));
+      // Plate: shut before the pass, open mid-glide, shut at the end.
+      expect(r.opens[0]).toBe(0);
+      expect(r.opens[Math.floor((OUT + BACK / 2) * 60)]).toBe(1);
+      expect(r.opens[r.opens.length - 1]).toBe(0);
+    });
+  }
+
+  it('is exactly at the spot when the out leg ends', async () => {
+    const { Sortie } = await load<{ Sortie: SortieCtor }>('chart/fx/movers.ts');
+    let last: [number, number] = [0, 0];
+    const scene = {
+      own() {}, placeAt: (_pk: string, x: number, y: number) => { last = [x, y]; }, faceView() {}, goalOf: () => [-120, 260] as [number, number],
+      currentScale: () => 1, release() {}, restoreFacing() {}, facingOf: () => 1,
+    };
+    const s = new Sortie(scene, 'ag', [0, 0], () => [300, 100], () => null, 1, 0, 2, 0, false, 0, true);
+    s.update(0.5); s.update(0.5);
+    expect(Math.hypot(last[0] - 300, last[1] - 100)).toBeLessThan(1e-6 * Math.hypot(300, 100));
+  });
+});
